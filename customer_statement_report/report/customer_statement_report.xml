<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_customer_statement" model="report.paperformat">
        <field name="name">Customer Statement A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line">False</field>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_statement_report.report_customer_statement_document</field>
        <field name="report_file">customer_statement_report.report_customer_statement_document</field>
        <field name="print_report_name">'customer_statement_' + (object.date_from and object.date_from.strftime('%b_%Y') or '') + '_' + (object.company_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_customer_statement"/>
    </record>

</odoo>
