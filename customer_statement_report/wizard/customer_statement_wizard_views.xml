<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_statement_wizard_form" model="ir.ui.view">
        <field name="name">customer.statement.wizard.form</field>
        <field name="model">customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Statement">
                <group>
                    <div style="margin-bottom:12px;">
                        <button name="action_bulk_email_prepare" string="Send Bulk Email"
                                type="object" class="btn-primary" icon="fa-users" style="width:100%;"/>
                    </div>
                    <div style="border-top:0.5px solid #ccc;padding-top:12px;"/>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="statement_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group string="Customers">
                    <field name="partner_ids" widget="many2many_tags"
                           placeholder="Leave empty to include all customers with transactions"/>
                </group>
                <footer>
                    <button name="action_print_statement" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_send_by_email" string="Send by Email"
                            type="object" class="btn-secondary" icon="fa-envelope"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Statement</field>
        <field name="res_model">customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_customer_statement"
        name="Customer Statement"
        parent="account.menu_finance_reports"
        action="action_customer_statement_wizard"
        sequence="10"/>

</odoo>
