<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- noupdate="1" so re-upgrading the module won't overwrite
             values the admin has customized in System Parameters. -->

        <record id="param_image_export_disk_path" model="ir.config_parameter">
            <field name="key">softg.image_export.disk_path</field>
            <field name="value">/var/www/robofix-images</field>
        </record>

        <record id="param_image_export_url_prefix" model="ir.config_parameter">
            <field name="key">softg.image_export.url_prefix</field>
            <field name="value">https://robofix.uk/img</field>
        </record>

    </data>
</odoo>
